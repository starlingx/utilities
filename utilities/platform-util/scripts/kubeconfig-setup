#!/bin/bash
#
# Copyright (c) 2023,2025-2026 Wind River Systems, Inc.
#
# SPDX-License-Identifier: Apache-2.0
#
# Sets up Kubernetes configuration for the logged-in user.
# Runs on the platform node (local) or on a remote CLI workstation.
# IS_REMOTE=true is set by configure_client.sh when running in remote CLI mode.
#

# Tells whether or not this is local or remote
if [ "${IS_REMOTE}" != "true" ]; then

    # -----------------------------------------------------------------------
    # Local (platform node) — original kubeconfig-setup
    # -----------------------------------------------------------------------

    # Set Kubernetes config file.
    mkdir -p -m 750 "$HOME/.kube"
    rm -f "$HOME/.kube/config"
    touch "$HOME/.kube/config"
    chmod 600 "$HOME/.kube/config"
    CERT_AUTH_DATA=$(/usr/local/bin/k8s-ca-read | base64 -w0)
    CLUSTER_HOST_IP=$(grep -w controller-cluster-host /etc/hosts | awk '{print $1}')
    if [[ $CLUSTER_HOST_IP =~ .*:.* ]]; then
        CLUSTER_HOST_IP="[$CLUSTER_HOST_IP]"
    fi
    SERVER_URL="https://$CLUSTER_HOST_IP:16443"

    # Check if OIDC login config is available
    OIDC_CONFIG_FILE="/opt/platform/.oidc_login_config"
    SHOULD_CONFIGURE_OIDC_LOGIN=false
    if [ -f "$OIDC_CONFIG_FILE" ]; then
        OIDC_CLIENT_ID=$(grep '^oidc-client-id:' "$OIDC_CONFIG_FILE" | awk '{print $2}')
        OIDC_CLIENT_SECRET=$(grep '^oidc-client-secret:' "$OIDC_CONFIG_FILE" | awk '{print $2}')
        OIDC_ISSUER_URL=$(grep '^oidc-issuer-url:' "$OIDC_CONFIG_FILE" | awk '{print $2}')
        OIDC_ISSUER_CA=$(grep '^oidc-issuer-ca:' "$OIDC_CONFIG_FILE" | awk '{print $2}')
        FLOATING_OAM_IP=$(grep -w oamcontroller /etc/hosts | awk '{print $1}')
        if [ -z "$FLOATING_OAM_IP" ]; then
            echo "ERROR: Could not resolve 'oamcontroller' from /etc/hosts. OIDC login will not be configured." >&2
        elif [ -n "$OIDC_CLIENT_ID" ] && [ -n "$OIDC_CLIENT_SECRET" ] && [ -n "$OIDC_ISSUER_URL" ]; then
            if [[ $FLOATING_OAM_IP =~ .*:.* ]]; then
                FLOATING_OAM_IP="[$FLOATING_OAM_IP]"
            fi
            SHOULD_CONFIGURE_OIDC_LOGIN=true
        fi
    fi

    if [ "$SHOULD_CONFIGURE_OIDC_LOGIN" = true ]; then
        printf "%s\n" \
               "apiVersion: v1" \
               "clusters:" \
               "- cluster:" \
               "    certificate-authority-data: $CERT_AUTH_DATA" \
               "    server: $SERVER_URL" \
               "  name: kubernetes" \
               "contexts:" \
               "- context:" \
               "    cluster: kubernetes" \
               "    user: $USER" \
               "  name: $USER@kubernetes" \
               "- context:" \
               "    cluster: kubernetes" \
               "    user: oidc-login-user" \
               "  name: oidc-login-user@kubernetes" \
               "current-context: $USER@kubernetes" \
               "kind: Config" \
               "preferences: {}" \
               "users:" \
               "- name: $USER" \
               "  user: {}" \
               "- name: oidc-login-user" \
               "  user:" \
               "    exec:" \
               "      apiVersion: client.authentication.k8s.io/v1" \
               "      command: kubectl" \
               "      args:" \
               "      - oidc-login" \
               "      - get-token" \
               "      - --oidc-issuer-url=${OIDC_ISSUER_URL}" \
               "      - --oidc-client-id=${OIDC_CLIENT_ID}" \
               "      - --oidc-client-secret=${OIDC_CLIENT_SECRET}" \
               "      - --certificate-authority-data=${OIDC_ISSUER_CA}" \
               "      - --oidc-extra-scope=openid,profile,email,groups" \
               "      - --oidc-extra-scope=offline_access" \
               "      - --skip-open-browser" \
               "      - --oidc-redirect-url=http://${FLOATING_OAM_IP}:8000" \
               "      - --listen-address=0.0.0.0:8000" \
               "      interactiveMode: IfAvailable" > "$HOME/.kube/config"
    else
        printf "%s\n" \
               "apiVersion: v1" \
               "clusters:" \
               "- cluster:" \
               "    certificate-authority-data: $CERT_AUTH_DATA" \
               "    server: $SERVER_URL" \
               "  name: kubernetes" \
               "contexts:" \
               "- context:" \
               "    cluster: kubernetes" \
               "    user: $USER" \
               "  name: $USER@kubernetes" \
               "current-context: $USER@kubernetes" \
               "kind: Config" \
               "preferences: {}" \
               "users:" \
               "- name: $USER" \
               "  user: {}" > "$HOME/.kube/config"
    fi

    # Add or replace KUBECONFIG variable in ".profile" file.
    VAR_COUNT=$(grep -cw '^export KUBECONFIG' "$HOME/.profile")
    if [[ "$VAR_COUNT" == "0" ]]; then
        echo 'export KUBECONFIG="$HOME/.kube/config"' >> "$HOME/.profile"
    else
        sed -i '/^\bexport KUBECONFIG\b/c\export KUBECONFIG="$HOME/.kube/config"' "$HOME/.profile"
    fi

else

    # -----------------------------------------------------------------------
    # Remote CLI — Sets kubeconfig based on environment variables
    # -----------------------------------------------------------------------

    # Read cluster name, server URL, and username from the existing kubeconfig
    EXISTING_KUBECONFIG="${HOME}/.kube/config"
    if [ ! -f "$EXISTING_KUBECONFIG" ]; then
        echo "ERROR: No existing kubeconfig found at $EXISTING_KUBECONFIG" >&2
        exit 1
    fi

    # Note: grep -m1 '^  name:' matches the first cluster name entry, which
    # appears under clusters[] before contexts[] in a standard kubeconfig.
    CLUSTER_NAME=$(grep -m1 '^  name:' "$EXISTING_KUBECONFIG" | awk '{print $2}')
    if [ -z "$CLUSTER_NAME" ]; then
        echo "ERROR: Could not parse cluster name from $EXISTING_KUBECONFIG" >&2
        exit 1
    fi

    SERVER_URL=$(grep -m1 '^ *server:' "$EXISTING_KUBECONFIG" | awk '{print $2}')
    if [ -z "$SERVER_URL" ]; then
        echo "ERROR: Could not parse server URL from $EXISTING_KUBECONFIG" >&2
        exit 1
    fi

    USERNAME=$(grep '^ *user:' "$EXISTING_KUBECONFIG" | awk '{print $2}' | grep -v '^oidc-login-user$' | head -1)
    USER=${USERNAME:-${USER:-$(whoami)}}

    # OS_CACERT must point to a PEM file accessible inside the container
    # (i.e. a path under the mounted workdir /wd).
    if [ -z "$OS_CACERT" ]; then
        echo "ERROR: OS_CACERT is not set" >&2
        exit 1
    fi
    if [ ! -f "$OS_CACERT" ]; then
        echo "ERROR: OS_CACERT file not found: $OS_CACERT" >&2
        exit 1
    fi
    CERT_AUTH_DATA=$(base64 -w0 "$OS_CACERT")

    # Check if OIDC env vars are present
    SHOULD_CONFIGURE_OIDC_LOGIN=false
    if [ -n "$OIDC_CLIENT_ID" ] && [ -n "$OIDC_CLIENT_SECRET" ] && [ -n "$OIDC_ISSUER_URL" ]; then
        SHOULD_CONFIGURE_OIDC_LOGIN=true
    fi

    mkdir -p -m 750 "$HOME/.kube"
    > "$HOME/.kube/config"
    chmod 600 "$HOME/.kube/config"

    if [ "$SHOULD_CONFIGURE_OIDC_LOGIN" = true ]; then
        printf "%s\n" \
               "apiVersion: v1" \
               "clusters:" \
               "- cluster:" \
               "    certificate-authority-data: $CERT_AUTH_DATA" \
               "    server: $SERVER_URL" \
               "  name: $CLUSTER_NAME" \
               "contexts:" \
               "- context:" \
               "    cluster: $CLUSTER_NAME" \
               "    user: $USER" \
               "  name: $USER@$CLUSTER_NAME" \
               "- context:" \
               "    cluster: $CLUSTER_NAME" \
               "    user: oidc-login-user" \
               "  name: oidc-login-user@$CLUSTER_NAME" \
               "current-context: $USER@$CLUSTER_NAME" \
               "kind: Config" \
               "preferences: {}" \
               "users:" \
               "- name: $USER" \
               "  user: {}" \
               "- name: oidc-login-user" \
               "  user:" \
               "    exec:" \
               "      apiVersion: client.authentication.k8s.io/v1" \
               "      command: kubectl" \
               "      args:" \
               "      - oidc-login" \
               "      - get-token" \
               "      - --oidc-issuer-url=${OIDC_ISSUER_URL}" \
               "      - --oidc-client-id=${OIDC_CLIENT_ID}" \
               "      - --oidc-client-secret=${OIDC_CLIENT_SECRET}" \
               "      - --certificate-authority-data=${OIDC_ISSUER_CA}" \
               "      - --oidc-extra-scope=openid,profile,email,groups" \
               "      - --oidc-extra-scope=offline_access" \
               "      - --skip-open-browser" \
               "      - --token-cache-dir=cache" \
               "      interactiveMode: IfAvailable" > "$HOME/.kube/config"
    else
        printf "%s\n" \
               "apiVersion: v1" \
               "clusters:" \
               "- cluster:" \
               "    certificate-authority-data: $CERT_AUTH_DATA" \
               "    server: $SERVER_URL" \
               "  name: $CLUSTER_NAME" \
               "contexts:" \
               "- context:" \
               "    cluster: $CLUSTER_NAME" \
               "    user: $USER" \
               "  name: $USER@$CLUSTER_NAME" \
               "current-context: $USER@$CLUSTER_NAME" \
               "kind: Config" \
               "preferences: {}" \
               "users:" \
               "- name: $USER" \
               "  user: {}" > "$HOME/.kube/config"
    fi

fi
